(* BM_ContentServer_Compromise.pv
   Tests whether a compromised content-channel server can determine
   which device produced a piece of content it has received.

   f_device_sk, the content-channel server's own relay-terminus key,
   is leaked to the adversary. c_device_sk (the gatekeeper server's
   key) and v_token_sk (the validator's key) stay private -- the
   credential channel, which carries the device's encrypted token,
   never reaches the content-channel server at all, so its compromise
   has no bearing on the token's secrecy.

   Result: observational equivalence holds. A compromised
   content-channel server can read ContentHash and the nonce and
   compute PacketHash directly, exactly as it would legitimately, but
   gains no information about device identity. *)

type skey.
type pkey.

fun pk(skey): pkey.
fun aenc(bitstring, pkey, bitstring): bitstring.
reduc forall m: bitstring, sk: skey, rnd: bitstring; adec(aenc(m, pk(sk), rnd), sk) = m.

fun hash(bitstring): bitstring.

free pub: channel.

free v_token_sk: skey [private].
free c_device_sk: skey [private].
free f_device_sk: skey [private].

free T1: bitstring [private].
free T2: bitstring [private].
free imgX: bitstring.
free imgY: bitstring.

let device(token: bitstring, content: bitstring) =
    let h = hash(content) in
    new n: bitstring;
    let packethash = hash((h, n)) in
    new rnd_token: bitstring;
    let enc_token = aenc(token, pk(v_token_sk), rnd_token) in
    new rnd_bundle: bitstring;
    let enc_bundle = aenc((enc_token, packethash), pk(c_device_sk), rnd_bundle) in
    new rnd_content: bitstring;
    let enc_content = aenc((h, n), pk(f_device_sk), rnd_content) in
    out(pub, enc_content);
    out(pub, enc_bundle).

let content_server =
    !
    in(pub, enc_content_in: bitstring);
    let (h_in: bitstring, n_in: bitstring) = adec(enc_content_in, f_device_sk) in
    let candidate = hash((h_in, n_in)) in
    out(pub, candidate).

process
    out(pub, pk(v_token_sk));
    out(pub, pk(c_device_sk));
    out(pub, f_device_sk);
    (
        device(choice[T1,T2], imgX)
        | device(choice[T2,T1], imgY)
        | content_server
    )
