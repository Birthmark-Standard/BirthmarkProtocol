(* BM_Registry_Convergence.pv
   Tests whether one compromised content-channel server can, on its
   own, satisfy a two-independent-submission requirement at the
   registry.

   Design modeled here: each content-channel server signs its
   registry submission with its own per-server identity key (the same
   key that protects its content-channel relay terminus), and the
   registry requires two matching submissions signed by two distinct
   server identities before finalizing a record.

   f_device_sk is leaked, representing full compromise of one server.
   i_device_sk, the other server's key, stays private. The query asks
   whether the adversary, holding only the first key, can derive the
   second.

   Result: the second server's key never becomes derivable. One
   compromised server can produce only its own signature, never the
   second one the registry's write rule requires. *)

type skey.
type pkey.

fun pk(skey): pkey.
fun sign(bitstring, skey): bitstring.
reduc forall m: bitstring, sk: skey; checksign(sign(m, sk), pk(sk)) = m.

free pub: channel.

free f_device_sk: skey [private].
free i_device_sk: skey [private].

free content_hash: bitstring.

query attacker(i_device_sk).

let content_server(sk: skey) =
    !
    out(pub, sign(content_hash, sk)).

process
    out(pub, pk(f_device_sk));
    out(pub, pk(i_device_sk));
    out(pub, f_device_sk);
    (
        content_server(f_device_sk)
        | content_server(i_device_sk)
    )
