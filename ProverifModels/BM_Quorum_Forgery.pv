(* BM_Quorum_Forgery.pv
   Tests whether compromising one of three gatekeeper/match-board pairs
   lets an attacker force the two-of-three quorum to accept a PacketHash
   the validator never approved.

   g1_sk (the first gatekeeper's relay-terminus key) is leaked, giving the
   attacker full read/write access to match_board_1 directly -- gatekeeper
   1 itself is not modeled as a separate process, since a leaked key
   already gives the attacker everything that process would do. g2_sk and
   g3_sk stay private: gatekeepers 2 and 3 remain honest, each posting a
   PacketHash to its own board only after independently verifying the
   validator's signature and decrypting with the BlindShare_key it was
   sent alongside.

   Reaching quorum (any two of the three boards agreeing) is marked with
   a quorum_reached event. Genuine validator approval is marked with a
   validator_approved event. The query asks whether every quorum_reached
   event is preceded by a validator_approved event for the same value --
   i.e., whether the one compromised board can ever get something
   accepted that skipped real validator approval.

   Each gatekeeper posts to its board twice, since two of the three race
   branches below each need their own read of it.

   Only match_board_1 is public: that is what "gatekeeper 1 is compromised"
   means here, since a public channel already gives the attacker full
   read/write access without needing gatekeeper 1 modeled as its own
   process. match_board_2, match_board_3, and quorum_out are private, so
   the only way anything reaches them is through gatekeeper 2 or 3's own
   honest decrypt-verify-compare sequence. *)

type key. type skey. type pkey.
fun pk(skey): pkey.
fun aenc(bitstring, pkey, bitstring): bitstring.
reduc forall m:bitstring, sk:skey, rnd:bitstring; adec(aenc(m, pk(sk), rnd), sk) = m.
fun senc(bitstring, key): bitstring.
reduc forall m:bitstring, k:key; sdec(senc(m, k), k) = m.
fun sign(bitstring, skey): bitstring.
reduc forall m:bitstring, sk:skey; checksign(sign(m, sk), pk(sk)) = m.
fun hash(bitstring): bitstring.

free pub: channel.
free c_to_val: channel [private].
free val_to_c: channel [private].
free match_board_1: channel.
free match_board_2: channel [private].
free match_board_3: channel [private].
free quorum_out: channel [private].
free v_ok: bitstring.
free v_no: bitstring.

free v_token_sk: skey [private]. letfun v_token_pk = pk(v_token_sk).
free c_device_sk: skey [private]. letfun c_device_pk = pk(c_device_sk).
free g1_sk: skey [private].
free g2_sk: skey [private]. letfun g2_pk = pk(g2_sk).
free g3_sk: skey [private]. letfun g3_pk = pk(g3_sk).

free T1: bitstring [private].
free T2: bitstring [private].
free imgX: bitstring.

event validator_approved(bitstring).
event quorum_reached(bitstring).

let device(token: bitstring, content: bitstring) =
    let h = hash(content) in
    new n: bitstring;
    let packethash = hash((h, n)) in
    new rnd_token: bitstring;
    let enc_token = aenc(token, v_token_pk, rnd_token) in
    new rnd_bundle: bitstring;
    let enc_bundle = aenc((enc_token, packethash), c_device_pk, rnd_bundle) in
    out(pub, enc_bundle).

let credential_processor =
    !
    in(pub, enc_bundle_in: bitstring);
    let (enc_token_in: bitstring, packethash_in: bitstring) = adec(enc_bundle_in, c_device_sk) in
    new blindshare_key: key;
    let wrapped = senc(packethash_in, blindshare_key) in
    out(c_to_val, (enc_token_in, wrapped));
    in(val_to_c, (decision: bitstring, wrapped_signed: bitstring));
    let wrapped_checked = checksign(wrapped_signed, v_token_pk) in
    let packethash_confirmed = sdec(wrapped_checked, blindshare_key) in
    if (decision = v_ok) && (packethash_confirmed = packethash_in) then
    (
        event validator_approved(packethash_in);
        new rnd_g1: bitstring;
        let pkt_g1 = aenc((packethash_in, wrapped_signed, blindshare_key), pk(g1_sk), rnd_g1) in
        new rnd_g2: bitstring;
        let pkt_g2 = aenc((packethash_in, wrapped_signed, blindshare_key), g2_pk, rnd_g2) in
        new rnd_g3: bitstring;
        let pkt_g3 = aenc((packethash_in, wrapped_signed, blindshare_key), g3_pk, rnd_g3) in
        ( out(pub, pkt_g1) | out(pub, pkt_g2) | out(pub, pkt_g3) )
    ).

let validator =
    !
    in(c_to_val, (enc_token_in: bitstring, wrapped_in: bitstring));
    let token_in = adec(enc_token_in, v_token_sk) in
    if (token_in = T1) || (token_in = T2) then
        out(val_to_c, (v_ok, sign(wrapped_in, v_token_sk)))
    else
        out(val_to_c, (v_no, sign(wrapped_in, v_token_sk))).

let gatekeeper_2 =
    !
    in(pub, pkt_in: bitstring);
    let (p: bitstring, sig: bitstring, k: key) = adec(pkt_in, g2_sk) in
    let sig_checked = checksign(sig, v_token_pk) in
    let p_confirmed = sdec(sig_checked, k) in
    if (p_confirmed = p) then
    ( out(match_board_2, p) | out(match_board_2, p) ).

let gatekeeper_3 =
    !
    in(pub, pkt_in: bitstring);
    let (p: bitstring, sig: bitstring, k: key) = adec(pkt_in, g3_sk) in
    let sig_checked = checksign(sig, v_token_pk) in
    let p_confirmed = sdec(sig_checked, k) in
    if (p_confirmed = p) then
    ( out(match_board_3, p) | out(match_board_3, p) ).

let quorum_12 =
    !
    in(match_board_1, p1: bitstring);
    in(match_board_2, p2: bitstring);
    if (p1 = p2) then
    ( event quorum_reached(p1); out(quorum_out, p1) ).

let quorum_13 =
    !
    in(match_board_1, p1: bitstring);
    in(match_board_3, p3: bitstring);
    if (p1 = p3) then
    ( event quorum_reached(p1); out(quorum_out, p1) ).

let quorum_23 =
    !
    in(match_board_2, p2: bitstring);
    in(match_board_3, p3: bitstring);
    if (p2 = p3) then
    ( event quorum_reached(p2); out(quorum_out, p2) ).

query p: bitstring; event(quorum_reached(p)) ==> event(validator_approved(p)).

process
    out(pub, v_token_pk); out(pub, c_device_pk); out(pub, g1_sk); out(pub, g2_pk); out(pub, g3_pk);
    (
        (!device(T1, imgX))
        | (!credential_processor)
        | (!validator)
        | (!gatekeeper_2) | (!gatekeeper_3)
        | (!quorum_12) | (!quorum_13) | (!quorum_23)
    )
