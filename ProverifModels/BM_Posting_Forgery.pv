(* BM_Posting_Forgery.pv
   Tests whether anyone other than the credential validator can
   produce a signature the match board would accept over a posted
   record hash.

   v_token_sk (the validator's signing key) stays private throughout;
   nothing is leaked. The validator process is unboundedly replicated,
   modeling arbitrarily many signing operations rather than just one.
   The query asks whether the attacker can ever derive v_token_sk.

   Result: the key never becomes derivable. No party -- not a
   gatekeeper, not the credential processor, not a content-channel
   server, not any combination of them -- can ever produce this
   signature without it. Its role has shifted from the original
   single-board design: it no longer gates what a board accepts
   directly, since boards now check the credential processor's own
   signature (BM_Quorum_Forgery.pv, BM_Quorum_Collusion.pv). It
   still gates whether the credential processor is willing to sign
   a PacketHash in the first place, which is what those two models
   depend on this key's secrecy to hold. *)

type skey. type pkey.
fun pk(skey): pkey.
fun sign(bitstring, skey): bitstring.
reduc forall m:bitstring, sk:skey; checksign(sign(m, sk), pk(sk)) = m.

free pub: channel.
free v_token_sk: skey [private]. letfun v_token_pk = pk(v_token_sk).
free enc_packethash: bitstring [private].

let validator =
    out(pub, sign(enc_packethash, v_token_sk)).

query attacker(v_token_sk).

process
    out(pub, v_token_pk);
    (!validator)
