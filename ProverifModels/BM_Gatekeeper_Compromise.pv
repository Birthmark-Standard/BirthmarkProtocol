(* BM_Gatekeeper_Compromise.pv
   Tests whether a compromised gatekeeper server can determine which
   device produced a piece of content.

   c_device_sk, the gatekeeper's own relay-terminus key, is leaked to
   the adversary, giving it PacketHash in the clear, exactly as the
   gatekeeper would legitimately hold it. v_token_sk (the validator's
   key) stays private, so the device's encrypted token remains opaque
   even to a fully compromised gatekeeper.

   The gatekeeper-to-validator round trip (the one-time blinding key,
   the signature exchange) is omitted: it doesn't change what the
   gatekeeper can extract from the token either way, since that round
   trip only ever touches the already-encrypted PacketHash, never the
   token.

   Result: observational equivalence holds. Holding PacketHash in the
   clear does not, by itself, reveal which device produced it. *)

type skey.
type pkey.
type key.

fun pk(skey): pkey.
fun aenc(bitstring, pkey, bitstring): bitstring.
reduc forall m: bitstring, sk: skey, rnd: bitstring; adec(aenc(m, pk(sk), rnd), sk) = m.

fun senc(bitstring, key): bitstring.
reduc forall m: bitstring, k: key; sdec(senc(m, k), k) = m.

fun hash(bitstring): bitstring.

free pub: channel.

free v_token_sk: skey [private].
free c_device_sk: skey [private].
free f_device_sk: skey [private].

free T1: bitstring [private].
free T2: bitstring [private].
free imgX: bitstring.
free imgY: bitstring.

let device(token: bitstring, content: bitstring) =
    let h = hash(content) in
    new n: bitstring;
    let packethash = hash((h, n)) in
    new rnd_token: bitstring;
    let enc_token = aenc(token, pk(v_token_sk), rnd_token) in
    new rnd_bundle: bitstring;
    let enc_bundle = aenc((enc_token, packethash), pk(c_device_sk), rnd_bundle) in
    new rnd_content: bitstring;
    let enc_content = aenc((h, n), pk(f_device_sk), rnd_content) in
    out(pub, enc_content);
    out(pub, enc_bundle).

let gatekeeper =
    !
    in(pub, enc_bundle_in: bitstring);
    let (enc_token_in: bitstring, packethash_in: bitstring) = adec(enc_bundle_in, c_device_sk) in
    new blindshare_key: key;
    let wrapped = senc(packethash_in, blindshare_key) in
    out(pub, (enc_token_in, wrapped)).

process
    out(pub, pk(v_token_sk));
    out(pub, c_device_sk);
    out(pub, pk(f_device_sk));
    (
        device(choice[T1,T2], imgX)
        | device(choice[T2,T1], imgY)
        | gatekeeper
    )
